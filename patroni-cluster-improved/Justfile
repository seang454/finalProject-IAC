# =============================================================================
# Justfile — Patroni HA Cluster
# Location: ~/final-project/patroni-cluster/Justfile
#
# Usage:
#   just              # show available commands
#   just provision    # create GCP VMs
#   just site         # configure full cluster
#   just etcd         # run etcd role only
# =============================================================================

# Path to project venv binaries — all ansible commands use this
venv := ".venv/bin"

# Default — show available commands
default:
    @just --list

# ── Provisioning ──────────────────────────────────────────────────────────────

# Create GCP VMs (run this first)
provision:
    @echo "🚀 Provisioning GCP instances..."
    {{ venv }}/ansible-playbook provision.yml --ask-become-pass

# Setup venv only
venv-setup:
    @echo "🐍 Setting up Python virtual environments..."
    {{ venv }}/ansible-playbook provision.yml --tags venv --ask-become-pass

# Create instances only (venv must exist)
create:
    @echo "☁️  Creating GCP instances..."
    {{ venv }}/ansible-playbook provision.yml --tags create


# Regenerate hosts.ini from inventory/gcp_instances.json (no GCP API call needed)
refresh:
    @echo "Refreshing inventory from gcp_instances.json..."
    python3 refresh_inventory.py
    @echo "Done — run 'just site' to configure the cluster"

# ── Cluster setup ─────────────────────────────────────────────────────────────

# Configure full HA cluster (run after provision)
site:
    @echo "Starting Patroni HA database cluster setup..."
    python3 refresh_inventory.py
    {{ venv }}/ansible-playbook site.yml

# Run with vault password prompt
site-vault:
    @echo "🔐 Starting cluster setup with vault..."
    {{ venv }}/ansible-playbook site.yml --ask-vault-pass

# ── Individual roles ──────────────────────────────────────────────────────────

# Configure /etc/hosts on all nodes
hosts:
    @echo "📋 Configuring hostnames..."
    {{ venv }}/ansible-playbook site.yml --tags hosts

# Install and start etcd cluster
etcd:
    @echo "🗄️  Setting up etcd cluster..."
    {{ venv }}/ansible-playbook site.yml --tags etcd

# Install PostgreSQL
postgresql:
    @echo "🐘 Installing PostgreSQL..."
    {{ venv }}/ansible-playbook site.yml --tags postgresql

# Install and configure Patroni
patroni:
    @echo "👑 Configuring Patroni..."
    {{ venv }}/ansible-playbook site.yml --tags patroni

# Bootstrap leader only
patroni-leader:
    @echo "👑 Bootstrapping Patroni leader..."
    {{ venv }}/ansible-playbook site.yml --tags patroni-leader

# Join replicas
patroni-replicas:
    @echo "🔁 Joining Patroni replicas..."
    {{ venv }}/ansible-playbook site.yml --tags patroni-replicas

# Install and configure HAProxy
haproxy:
    @echo "⚖️  Setting up HAProxy..."
    {{ venv }}/ansible-playbook site.yml --tags haproxy

# Install and configure Keepalived
keepalived:
    @echo "💓 Setting up Keepalived VIP..."
    {{ venv }}/ansible-playbook site.yml --tags keepalived

# ── Backup (pgBackRest) ───────────────────────────────────────────────────────

# Install and configure pgBackRest on all pg-nodes
backup-setup:
    @echo "💾 Setting up pgBackRest backup..."
    {{ venv }}/ansible-playbook site.yml -i inventory/hosts.ini --tags pgbackrest

# Deploy backup script and cron jobs to all pg-nodes (run after backup-setup)
backup-scripts:
    @echo "📜 Deploying backup scripts and cron jobs..."
    {{ venv }}/ansible-playbook site.yml -i inventory/hosts.ini --tags backup-scripts -e "backup_scripts_state=present"

# Remove backup script and cron jobs from all pg-nodes
backup-scripts-remove:
    @echo "🗑️  Removing backup scripts and cron jobs..."
    {{ venv }}/ansible-playbook site.yml -i inventory/hosts.ini --tags backup-scripts -e "backup_scripts_state=absent"

# Run a full backup now (on the current leader)
backup-full:
    @echo "💾 Running full backup..."
    {{ venv }}/ansible patroni_cluster -m command \
        -a "sudo -u postgres /usr/local/bin/patroni-backup.sh full" \
        -i inventory/hosts.ini

# Run a differential backup now (on the current leader)
backup-diff:
    @echo "💾 Running differential backup..."
    {{ venv }}/ansible patroni_cluster -m command \
        -a "sudo -u postgres /usr/local/bin/patroni-backup.sh diff" \
        -i inventory/hosts.ini

# Show backup info and history
backup-info:
    @echo "📋 Showing backup info..."
    {{ venv }}/ansible patroni_cluster -m command \
        -a "sudo -u postgres pgbackrest --stanza=postgres-cluster info" \
        -i inventory/hosts.ini

# Verify backup integrity (leader only — replicas skip automatically)
backup-verify:
    @echo "🔍 Verifying backup integrity..."
    {{ venv }}/ansible patroni_cluster -m shell \
        -a "curl -sf http://localhost:8008/leader > /dev/null && sudo -u postgres pgbackrest --stanza=postgres-cluster check || echo 'SKIPPED — not the leader'" \
        -i inventory/hosts.ini

# ── Operations ────────────────────────────────────────────────────────────────

# Verify cluster health
verify:
    @echo "🔍 Verifying cluster health..."
    {{ venv }}/ansible-playbook site.yml --tags verify

# Manual switchover (prompts for candidate)
failover:
    @echo "🔄 Running manual switchover..."
    {{ venv }}/ansible-playbook failover.yml

# Force failover to specific node — usage: just failover-to pg-node2
failover-to node:
    @echo "🔄 Failing over to {{ node }}..."
    {{ venv }}/ansible-playbook failover.yml -e "failover_candidate={{ node }}"

# Reinitialise a corrupted replica — usage: just reinit pg-node3
reinit node:
    @echo "🔧 Reinitialising {{ node }}..."
    {{ venv }}/ansible-playbook reinit-replica.yml -e "target_node={{ node }}"

# ── Checks ────────────────────────────────────────────────────────────────────

# Check cluster status on all pg-nodes
status:
    @echo "📊 Checking cluster status..."
    {{ venv }}/ansible patroni_cluster -m command \
        -a "patronictl -c /etc/patroni/patroni.yml list" \
        -i inventory/hosts.ini

# Ping all nodes
ping:
    @echo "🏓 Pinging all nodes..."
    {{ venv }}/ansible all -m ping -i inventory/hosts.ini

# Check etcd cluster health (uses v2 API — etcd 3.3 installed via apt)
etcd-health:
    @echo "🔍 Checking etcd health..."
    {{ venv }}/ansible etcd_cluster -m command \
        -a "etcdctl cluster-health" \
        -i inventory/hosts.ini

# Check HAProxy stats on all ha-proxy nodes
haproxy-stats:
    @echo "📈 Checking HAProxy stats..."
    {{ venv }}/ansible haproxy -m uri \
        -a "url=http://localhost:7000/stats return_content=no" \
        -i inventory/hosts.ini

# Check which ha-proxy node holds the VIP
vip:
    @echo "🌐 Checking VIP location..."
    {{ venv }}/ansible keepalived -m shell \
        -a "ip addr show | grep 10.154.0.100 && echo 'VIP IS HERE' || echo 'VIP not on this node'" \
        -i inventory/hosts.ini

# ── Full workflow ─────────────────────────────────────────────────────────────

# Full setup from scratch: provision → configure → backup
all:
    @echo "Full cluster setup from scratch..."
    just provision
    @echo "Waiting 30s for VMs to be fully ready..."
    sleep 30
    just refresh
    just site
    just backup-setup
    just verify
    @echo "Cluster is ready!"

# ── Venv bootstrap ────────────────────────────────────────────────────────────

# Create .venv and install requirements — run this ONCE before anything else
bootstrap:
    @echo "🔧 Bootstrapping project venv..."
    python3 -m venv .venv
    {{ venv }}/pip install --upgrade pip
    {{ venv }}/pip install -r requirements.txt
    @echo "✅ Venv ready — run 'just provision' next"
