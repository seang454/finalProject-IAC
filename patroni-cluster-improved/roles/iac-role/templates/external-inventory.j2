# ============================================================
# Patroni HA Cluster Inventory
# Generated by Ansible — do not edit manually
# ============================================================

[all:vars]
ansible_user={{ agent_user }}
ansible_ssh_private_key_file={{ ssh_pubkey_path | replace('.pub', '') }}
ansible_python_interpreter=/usr/bin/python3
ansible_ssh_extra_args='-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'

[local]
localhost ansible_connection=local ansible_python_interpreter=.venv/bin/python3

[patroni_cluster]
{% for instance in gcp_instances.results %}
{% if instance.name is defined and instance.skipped is not defined and instance.name.startswith('pg-node') %}
{{ instance.name }} ansible_host={{ instance.networkInterfaces[0].accessConfigs[0].natIP }} internal_ip={{ instance.networkInterfaces[0].networkIP }}
{% endif %}
{% endfor %}

[etcd_cluster]
{% for instance in gcp_instances.results %}
{% if instance.name is defined and instance.skipped is not defined and instance.name.startswith('pg-node') %}
{{ instance.name }} ansible_host={{ instance.networkInterfaces[0].accessConfigs[0].natIP }} internal_ip={{ instance.networkInterfaces[0].networkIP }}
{% endif %}
{% endfor %}

[haproxy]
{% for instance in gcp_instances.results %}
{% if instance.name is defined and instance.skipped is not defined and instance.name.startswith('ha-proxy') %}
{{ instance.name }} ansible_host={{ instance.networkInterfaces[0].accessConfigs[0].natIP }} internal_ip={{ instance.networkInterfaces[0].networkIP }}
{% endif %}
{% endfor %}

[keepalived]
{% for instance in gcp_instances.results %}
{% if instance.name is defined and instance.skipped is not defined and instance.name.startswith('ha-proxy') %}
{{ instance.name }} ansible_host={{ instance.networkInterfaces[0].accessConfigs[0].natIP }} internal_ip={{ instance.networkInterfaces[0].networkIP }}
{% endif %}
{% endfor %}

[all:children]
patroni_cluster
etcd_cluster
haproxy
keepalived
