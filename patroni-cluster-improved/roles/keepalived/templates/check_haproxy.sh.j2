#!/bin/bash
# =============================================================================
# check_haproxy.sh
# Health check script called by Keepalived every {{ keepalived_check_interval }}s
#
# Returns:
#   0 = HAProxy is healthy → this node keeps/takes the VIP
#   1 = HAProxy is down    → priority reduced by 'weight', other node takes VIP
# =============================================================================

# Check if HAProxy process is running
if ! systemctl is-active --quiet haproxy; then
    echo "HAProxy is not running"
    exit 1
fi

# Check if HAProxy stats port is responding
if ! curl -sf --max-time 2 \
    "http://127.0.0.1:{{ haproxy_stats_port }}/stats" > /dev/null 2>&1; then
    echo "HAProxy stats endpoint not responding"
    exit 1
fi

# Check if HAProxy primary port is listening
if ! ss -tlnp | grep -q ":{{ haproxy_primary_port }} "; then
    echo "HAProxy primary port {{ haproxy_primary_port }} not listening"
    exit 1
fi

echo "HAProxy is healthy"
exit 0
