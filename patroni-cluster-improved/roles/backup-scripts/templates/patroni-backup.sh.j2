#!/bin/bash
# =============================================================================
# patroni-backup.sh
# Managed by Ansible — do not edit manually
#
# Runs pgBackRest backup only on the current Patroni leader.
# Safe to run on all nodes — replicas will skip automatically.
#
# Usage:
#   patroni-backup.sh full    # full backup
#   patroni-backup.sh diff    # differential backup
# =============================================================================

BACKUP_TYPE="${1:-full}"
STANZA="{{ pgbackrest_stanza }}"
PATRONI_API="http://{{ internal_ip }}:{{ patroni_api_port }}"
LOG_FILE="{{ backup_log_file }}"

log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') $1"
}

# ── Check if this node is the current Patroni leader ─────────────────────────
is_leader() {
    local http_code
    http_code=$(curl -sf -o /dev/null -w "%{http_code}" "${PATRONI_API}/leader" 2>/dev/null)
    [ "$http_code" = "200" ]
}

# ── Validate backup type ──────────────────────────────────────────────────────
if [[ "$BACKUP_TYPE" != "full" && "$BACKUP_TYPE" != "diff" && "$BACKUP_TYPE" != "incr" ]]; then
    log "ERROR: Invalid backup type '$BACKUP_TYPE'. Use: full, diff, or incr"
    exit 1
fi

# ── Main ──────────────────────────────────────────────────────────────────────
log "INFO: patroni-backup.sh started on {{ inventory_hostname }} (type=$BACKUP_TYPE)"

if is_leader; then
    log "INFO: This node is the leader — starting $BACKUP_TYPE backup..."

    pgbackrest --stanza="${STANZA}" --type="${BACKUP_TYPE}" backup

    EXIT_CODE=$?

    if [ $EXIT_CODE -eq 0 ]; then
        log "INFO: Backup completed successfully"
        exit 0
    else
        log "ERROR: Backup failed with exit code $EXIT_CODE"
        exit 1
    fi
else
    log "INFO: This node is NOT the leader — skipping backup"
    exit 0
fi
